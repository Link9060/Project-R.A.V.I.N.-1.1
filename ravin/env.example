# Copy this file to .env
# 1. Install & run OmniRoute: npx omniroute
# 2. Open http://localhost:20128/dashboard -> connect a provider -> Endpoints -> create a key
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_dashboard_key_here

# "auto" lets OmniRoute pick/fallback across your connected providers.
# Or pin one, e.g. groq/llama-3.3-70b-versatile
OMNIROUTE_MODEL=auto

# RAVIN-managed Supabase project. The public/anon key is used server-side
# for authenticated PostgREST requests; users do not provide these values.
SUPABASE_URL=https://bzjudqhjrbwglxdfbkmj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
