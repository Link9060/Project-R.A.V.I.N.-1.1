# RAVIN — environment variables
# Copy this file to .env for local development.
# Never commit your real API token.

# Cloudflare Workers AI
# Cloudflare Dashboard -> Workers AI -> Use REST API
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_workers_ai_api_token_here

# RAVIN model routing
# Conversation = fast everyday chat
CLOUDFLARE_CONVERSATION_MODEL=@cf/ibm-granite/granite-4.0-h-micro

# Work = reasoning, coding, files, planning, tools, vision-capable work
CLOUDFLARE_WORK_MODEL=@cf/google/gemma-4-26b-a4b-it

# RAVIN-managed Supabase project. The public/anon key is used server-side
# for authenticated PostgREST requests; users do not provide these values.
SUPABASE_URL=https://bzjudqhjrbwglxdfbkmj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
