# Copy this file to .env
# 1. Install & run OmniRoute: npx omniroute
# 2. Open http://localhost:20128/dashboard -> connect a provider -> Endpoints -> create a key
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_dashboard_key_here
OMNIROUTE_MODEL=auto

# RAVIN-managed Supabase project
SUPABASE_URL=https://bzjudqhjrbwglxdfbkmj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

# Hermes voice: Deepgram realtime speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2

# Hermes voice: ElevenLabs text-to-speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_chosen_voice_id_here
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Fast spoken-response model through OmniRoute
HERMES_MODEL=hy3-free

# Browser frontend origin used by the API CORS layer
FRONTEND_ORIGIN=https://link9060.github.io
