# RAVIN — environment variables
# Copy this file to .env for local development.
# Never commit real provider credentials.

# Runtime
PORT=3000
RAVIN_RELEASE=0.2.0
# Optional additional browser origin allowed by the API.
# FRONTEND_ORIGIN=https://example.com

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_workers_ai_api_token_here

# RAVIN model routing
# Conversation = fast everyday chat
CLOUDFLARE_CONVERSATION_MODEL=@cf/ibm-granite/granite-4.0-h-micro
# Work = reasoning, coding, files, planning, tools, vision-capable work
CLOUDFLARE_WORK_MODEL=@cf/google/gemma-4-26b-a4b-it

# Supabase
SUPABASE_URL=https://bzjudqhjrbwglxdfbkmj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

# Optional diagnostics. Disabled by default so server boots do not spend AI inference.
RAVIN_AI_SMOKE_TESTS=false

# Developer-only privileged capability. NEVER enable in customer production.
RAVIN_ENABLE_SELF_BUILD=false
